# PostgreSQL —— 远程实例，schema 为 public
SM_DB_URL=jdbc:postgresql://123.56.146.58:5432/skill_mesh
SM_DB_USER=gis_project
SM_DB_PASSWORD=replace-me

# MinIO（本机原生进程；9000/9001 已被 SonarQube 占用）
SM_MINIO_ENDPOINT=http://127.0.0.1:9100
SM_MINIO_CONSOLE=http://127.0.0.1:9101
SM_MINIO_ACCESS_KEY=skillmesh
SM_MINIO_SECRET_KEY=skillmesh-dev-secret
SM_MINIO_BUCKET=skillmesh-artifacts
# 上传临时对象几天后由对象存储自动清掉（会话过期了对象不会自己消失）
SM_MINIO_TEMP_EXPIRE_DAYS=1

# Keycloak（本机原生进程）
SM_KEYCLOAK_ISSUER=http://127.0.0.1:8180/kc/realms/skillmesh
# 网页控制台登录用的 OIDC 配置（不设就退回上面那个 issuer 与 skillmesh-cli）
SM_OIDC_ISSUER=
SM_OIDC_CLIENT_ID=skillmesh-cli
SM_KEYCLOAK_ADMIN_USER=admin
SM_KEYCLOAK_ADMIN_PASSWORD=admin
SM_KEYCLOAK_CLI_CLIENT=skillmesh-cli
SM_KEYCLOAK_TEST_CLIENT=skillmesh-test
SM_KEYCLOAK_TEST_USER=dev-user
SM_KEYCLOAK_TEST_PASSWORD=dev

# 构建 MinIO 用的 amd64 版 Go（本机默认 Go 是 32 位，链大二进制会 OOM）
SKILLMESH_GO_BIN=D:/tmp/goamd64/go/bin/go.exe
